# Nama variabel saja. Nilai asli hanya ada di server dan secret CI, tidak pernah di repo.

# URL dasar tiga aplikasi untuk pengalih aplikasi. Wajib diisi saat build.
# Staging memakai host staging supaya tidak melompat ke produksi.
NEXT_PUBLIC_APP_URL_PUBLIC=https://example.invalid
NEXT_PUBLIC_APP_URL_OUTLET=https://example.invalid
NEXT_PUBLIC_APP_URL_PORTAL=https://example.invalid
VITE_APP_URL_PUBLIC=https://example.invalid
VITE_APP_URL_OUTLET=https://example.invalid
VITE_APP_URL_PORTAL=https://example.invalid

# Sumber data frontend: "mock" (data contoh berlabel) atau "api". Wajib diisi saat build.
# "api" membaca backend apps/api; bila API gagal, halaman menampilkan gangguan, bukan data contoh.
NEXT_PUBLIC_DATA_SOURCE=mock
VITE_DATA_SOURCE=mock

# Website Publik (server Next.js): alamat API internal, tidak pernah dikirim ke browser.
# Contoh di compose: http://api:4000. Hanya dibaca saat runtime, bukan saat build.
API_INTERNAL_URL=http://localhost:4000

# API (apps/api). Daftar lengkap dan penjelasannya: infra/env/api.env.example.
# Nilai rahasia (DB_PASSWORD) hanya di server atau secret CI.
DB_HOST=
DB_PORT=3306
DB_USER=
DB_PASSWORD=
DB_NAME=
DB_TLS=verify
DB_TLS_CA_FILE=
APP_URL_PUBLIC=https://example.invalid
APP_URL_OUTLET=https://example.invalid
APP_URL_PORTAL=https://example.invalid
COOKIE_SECURE=true
STORAGE_DIR=
MEDIA_PUBLIC_BASE_URL=https://example.invalid/media
