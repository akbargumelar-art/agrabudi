# Nama variabel saja. Nilai asli hanya ada di server dan secret CI, tidak pernah di repo.

# URL dasar tiga aplikasi untuk pengalih aplikasi. Wajib diisi saat build.
# Staging memakai host staging supaya tidak melompat ke produksi.
NEXT_PUBLIC_APP_URL_PUBLIC=https://example.invalid
NEXT_PUBLIC_APP_URL_OUTLET=https://example.invalid
NEXT_PUBLIC_APP_URL_PORTAL=https://example.invalid
VITE_APP_URL_PUBLIC=https://example.invalid
VITE_APP_URL_OUTLET=https://example.invalid
VITE_APP_URL_PORTAL=https://example.invalid

# Sumber data frontend: "mock" (data contoh berlabel) atau "api". Wajib diisi saat build.
# Sampai backend M2-M4 ada, "api" menampilkan pesan layanan belum terhubung, bukan data contoh.
NEXT_PUBLIC_DATA_SOURCE=mock
VITE_DATA_SOURCE=mock
