# Hanya untuk `pnpm dev` di komputer lokal. Bukan secret: tidak ada kata sandi di sini.
# Isi DB_PASSWORD dan nilai lain yang berbeda di apps/api/.env.local (tidak masuk git).
NODE_ENV=development
PORT=4000
LOG_LEVEL=info
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=agrabudi_dev
DB_NAME=agrabudi_dev
DB_TLS=off
APP_URL_PUBLIC=http://localhost:3000
APP_URL_OUTLET=http://localhost:3001
APP_URL_PORTAL=http://localhost:3002
COOKIE_SECURE=false
STORAGE_DIR=./var/storage
MEDIA_PUBLIC_BASE_URL=http://localhost:4000/media
