# Runtime API. Salin ke infra/compose/api.env di server; JANGAN di-commit. Isi kata sandi di server saja.
NODE_ENV=production
LOG_LEVEL=info
# Akun runtime dengan hak DML saja (PRD 4.10), bukan root dan bukan akun migrator.
DB_HOST=
DB_PORT=3306
DB_USER=abk_api_runtime
DB_PASSWORD=
DB_NAME=
# verify = TLS dengan verifikasi CA dan nama host (wajib bila DB di server lain).
DB_TLS=verify
DB_TLS_CA_FILE=/run/secrets/db-ca.pem
DB_POOL_MAX=10
APP_URL_PUBLIC=https://agrabudi.id
APP_URL_OUTLET=https://outlet.agrabudi.id
APP_URL_PORTAL=https://portal.agrabudi.id
COOKIE_SECURE=true
MEDIA_PUBLIC_BASE_URL=https://agrabudi.id/media
# Masa berlaku quote Outlet dalam menit (SOP order final: TBD).
QUOTE_TTL_MINUTES=15
