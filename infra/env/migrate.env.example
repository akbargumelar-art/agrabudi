# Migrasi skema. Salin ke infra/compose/migrate.env; JANGAN di-commit.
# Akun migrator punya hak DDL dan hanya dipakai saat deploy (PRD 4.10).
NODE_ENV=production
DB_HOST=
DB_PORT=3306
DB_USER=abk_migrator
DB_PASSWORD=
DB_NAME=
DB_TLS=verify
DB_TLS_CA_FILE=/run/secrets/db-ca.pem
# Wajib diisi karena konfigurasi dibaca utuh; tidak dipakai migrasi.
APP_URL_PUBLIC=https://agrabudi.id
APP_URL_OUTLET=https://outlet.agrabudi.id
APP_URL_PORTAL=https://portal.agrabudi.id
STORAGE_DIR=/tmp
MEDIA_PUBLIC_BASE_URL=https://agrabudi.id/media
