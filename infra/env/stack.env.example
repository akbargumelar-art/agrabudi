# Variabel compose (bukan secret). Salin ke infra/compose/stack.env di server.
# RELEASE = commit yang dirilis; image diberi tag ini, tidak pernah `latest`.
RELEASE=
# URL tiga aplikasi (staging memakai host staging supaya tidak melompat ke produksi).
APP_URL_PUBLIC=https://agrabudi.id
APP_URL_OUTLET=https://outlet.agrabudi.id
APP_URL_PORTAL=https://portal.agrabudi.id
PUBLIC_HOST=agrabudi.id
OUTLET_HOST=outlet.agrabudi.id
PORTAL_HOST=portal.agrabudi.id
# Port loopback yang diteruskan terminator TLS server. Pilih port yang belum dipakai.
WEB_PORT=8080
# Lokasi CA server MySQL di host (untuk DB_TLS=verify).
DB_TLS_CA_HOST_PATH=/etc/agrabudi/db-ca.pem
